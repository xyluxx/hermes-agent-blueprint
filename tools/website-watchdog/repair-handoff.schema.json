{
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/tools/website-watchdog/repair-handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Bounded Website Repair Handoff",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "incident_id", "site_id", "host", "checkpoint", "credential_reference", "credential_principal", "allowed_action", "approval_reference", "approval_version", "operator_task_reference", "task_version", "requirement_version", "operation_key", "limits", "acceptance", "worker", "credential", "approval", "notification", "enforcement", "dispatch_enabled"],
  "properties": {
    "schema_version": {"const": 1}, "handoff_id": {"type": "string", "minLength": 1}, "incident_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}, "checkpoint": {"type": "string", "minLength": 1},
    "credential_reference": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://"}, "credential_principal": {"type": "string", "minLength": 1, "maxLength": 128}, "allowed_action": {"type": "string", "minLength": 1},
    "approval_reference": {"type": "string", "pattern": "^approval://operator-control/"}, "approval_version": {"type": "integer", "minimum": 1}, "operator_task_reference": {"type": "string", "pattern": "^kanban://task/"}, "task_version": {"type": "integer", "minimum": 1}, "requirement_version": {"type": "integer", "minimum": 1}, "operation_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "max_elapsed_seconds"], "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}, "max_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 900}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["health_url", "healthy_codes"], "properties": {"health_url": {"type": "string", "format": "uri", "pattern": "^https?://"}, "healthy_codes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 100, "maximum": 599}}}},
    "worker": {"$ref": "#/$defs/statusWithId"}, "credential": {"$ref": "#/$defs/status"}, "approval": {"$ref": "#/$defs/status"},
    "notification": {"type": "object", "additionalProperties": false, "required": ["status", "route"], "properties": {"status": {"enum": ["configured", "planned", "blocked"]}, "route": {"type": ["string", "null"]}}},
    "enforcement": {"$ref": "#/$defs/status"}, "dispatch_enabled": {"type": "boolean"}
  },
  "$defs": {
    "status": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["configured", "planned", "blocked"]}}},
    "statusWithId": {"type": "object", "additionalProperties": false, "required": ["status", "id"], "properties": {"status": {"enum": ["configured", "planned", "blocked"]}, "id": {"type": "string", "minLength": 1}}}
  }
}
