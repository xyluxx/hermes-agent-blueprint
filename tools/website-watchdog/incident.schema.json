{
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/tools/website-watchdog/incident.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Website Watchdog Incident",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "incident_id", "created_at", "updated_at", "site", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["queued", "leased", "resolved", "cancelled", "failed"]},
    "incident_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "site": {"$ref": "#/$defs/site"},
    "evidence": {"$ref": "#/$defs/event"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "lease_token": {"type": "string", "minLength": 16, "maxLength": 256},
    "leased_at": {"type": "string", "format": "date-time"},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "pre_action_probe": {"$ref": "#/$defs/probe"},
    "post_repair_probe": {"$ref": "#/$defs/probe"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256},
    "resolution_evidence": {"$ref": "#/$defs/metadata"},
    "failure_evidence": {"$ref": "#/$defs/metadata"},
    "release_evidence": {"$ref": "#/$defs/metadata"},
    "recovery_evidence": {"oneOf": [{"$ref": "#/$defs/probe"}, {"$ref": "#/$defs/event"}]},
    "repair_state": {"type": "object", "additionalProperties": false, "required": ["attempts", "started_ms", "deadline_ms", "operation_key"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "started_ms": {"type": "integer", "minimum": 0}, "deadline_ms": {"type": "integer", "minimum": 0}, "operation_key": {"type": "string", "minLength": 1, "maxLength": 256}}}
  },
  "$defs": {
    "site": {"type": "object", "additionalProperties": false, "required": ["id", "url"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https?://"}, "healthy_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 100, "maximum": 599}}, "content_contains": {"type": ["string", "null"], "maxLength": 2048}, "allowed_repairs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "notification_route": {"type": ["string", "null"]}, "credential_reference": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://"}, "credential_principal": {"type": "string", "minLength": 1}, "repair_policy": {"type": "string", "minLength": 1}, "approval_reference": {"type": "string", "pattern": "^approval://"}, "approval_version": {"type": "integer", "minimum": 1}, "operator_task_reference": {"type": "string", "pattern": "^kanban://"}, "task_version": {"type": "integer", "minimum": 1}, "requirement_version": {"type": "integer", "minimum": 1}, "operation_key": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["ok", "kind"], "properties": {"ok": {"type": "boolean"}, "kind": {"type": "string", "minLength": 1}, "status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}, "final_url": {"type": "string", "format": "uri"}, "latency_ms": {"type": "integer", "minimum": 0}}},
    "event": {"type": "object", "additionalProperties": false, "properties": {"kind": {"type": "string", "minLength": 1}, "site_id": {"type": "string", "minLength": 1}, "incident_id": {"type": ["string", "null"]}, "event_id": {"type": "string"}, "occurred_at": {"type": "string", "format": "date-time"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/probe"}}}},
    "metadata": {"oneOf": [{"type": "string", "maxLength": 4096}, {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}, {"type": "null"}]}
  }
}
