{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/executive-operator-conformance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "claim_scope", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "claim_scope": {"const": "reference-synthetic"},
    "scenarios": {
      "type": "array",
      "minItems": 65,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "authority", "implementation_path", "failure_path", "required", "expected_state", "claim_scope", "evidence_test_node_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^(C(0[1-9]|[1-3][0-9]|40)|T(15|16|17|18|19)-[A-Z0-9-]+|PENDING-SOUL-AGENTS)$"},
          "requirement": {"type": "string", "minLength": 8},
          "authority": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+$"},
          "implementation_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+$"},
          "failure_path": {"type": "string", "minLength": 8, "pattern": "\\S"},
          "required": {"type": "boolean"},
          "expected_state": {"enum": ["reference-synthetic-pass", "deployment-specific-blocked", "deployment-specific-unverified"]},
          "claim_scope": {"enum": ["reference-synthetic", "deployment-specific"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence_test_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^tests/test_[^:]+\\.py::test_.+$"}}
        },
        "allOf": [
          {"if": {"properties": {"required": {"const": true}}}, "then": {"properties": {"expected_state": {"const": "reference-synthetic-pass"}, "claim_scope": {"const": "reference-synthetic"}}}},
          {"if": {"properties": {"expected_state": {"pattern": "^deployment-specific"}}}, "then": {"required": ["reason"], "properties": {"claim_scope": {"const": "deployment-specific"}}}}
        ]
      }
    }
  }
}
