{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/action-intent.schema.json",
  "title": "Protected action intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_key", "action_class", "requester", "executor", "credential_principal", "recipient", "account", "target", "material_payload", "limits", "task_id", "task_version", "requirement_version", "artifact_id", "artifact_version", "target_version", "environment", "acceptance_id", "policy_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_key": {"type": "string", "minLength": 1},
    "action_class": {"type": "string", "minLength": 1},
    "requester": {"$ref": "#/$defs/requester"},
    "executor": {"$ref": "#/$defs/executor"},
    "credential_principal": {"$ref": "#/$defs/credential"},
    "recipient": {"$ref": "#/$defs/recipient"},
    "account": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "material_payload": {"type": "object"},
    "limits": {"type": "object"},
    "task_id": {"type": "string", "minLength": 1},
    "task_version": {"type": "integer", "minimum": 1},
    "requirement_version": {"type": "integer", "minimum": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "minLength": 1},
    "target_version": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "acceptance_id": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acceptance": false,
    "managed_envelope": {"type": "object", "additionalProperties": true, "required": ["board", "task_id"], "properties": {"board": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["role", "subject"], "properties": {"role": {"type": "string"}, "subject": {"type": "string", "minLength": 1}}},
    "requester": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "requester"}}}]},
    "executor": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "executor"}}}]},
    "credential": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "credential_principal"}}}]},
    "recipient": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "recipient"}}}]}
  }
}
