    "task_id":{"type":"string","minLength":1},"task_version":{"type":["string","integer"]},"requirement_version":{"type":["string","integer"]},"artifact_id":{"type":"string","minLength":1},"artifact_version":{"type":["string","integer"]},"target_id":{"type":"string","minLength":1},"target_version":{"type":["string","integer"]},
