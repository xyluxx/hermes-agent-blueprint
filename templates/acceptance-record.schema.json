{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/acceptance-record.schema.json","type":"object","additionalProperties":false,
  "required":["record_version","acceptance_id","status","disposition","task_id","task_version","requirement_version","artifact_id","artifact_version","target_id","target_version","environment","policy_version","policy_digest","submission_id","worker_id","accepter_id","criterion_results","criteria_digest","evidence_digest","reasons","issued_at","accepted_at","expires_at"],
  "properties":{
