{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/authority-map.schema.json",
  "title": "Executive Operator documentation authority map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authorities",
    "compatibility",
    "task_vocabulary",
    "schema_test_coverage",
    "mcp"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "normative_home",
          "explanatory_homes"
        ],
        "properties": {
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "normative_home": {
            "type": "string",
            "minLength": 1
          },
          "explanatory_homes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_range",
        "tested_upstream_build",
        "mismatch_policy",
        "consumers"
      ],
      "properties": {
        "semantic_range": {
          "const": ">=0.21.0,<0.22.0"
        },
        "tested_upstream_build": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "mismatch_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_only_inspection",
            "install",
            "update",
            "verified_claims"
          ],
          "properties": {
            "read_only_inspection": {
              "const": "allowed"
            },
            "install": {
              "const": "blocked_until_revalidated"
            },
            "update": {
              "const": "blocked_until_revalidated"
            },
            "verified_claims": {
              "const": "blocked_until_revalidated"
            }
          }
        },
        "consumers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "semantic_range": {
                "type": "boolean"
              },
              "tested_upstream_build": {
                "type": "boolean"
              },
              "authority_loaded": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "task_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative_home"
      ],
      "properties": {
        "normative_home": {
          "const": "contracts/task-lifecycle.yaml"
        }
      }
    },
    "schema_test_coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^tests/test_.+\\.py$"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "native_install_test",
        "example"
      ],
      "properties": {
        "baseline": {
          "const": "omitted_no_servers_configured"
        },
        "native_install_test": {
          "const": "passes_with_and_without_mcp_json"
        },
        "example": {
          "const": "templates/mcp.example.json"
        }
      }
    }
  }
}
