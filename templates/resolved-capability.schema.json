{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/resolved-capability.schema.json",
  "title": "Resolved Executive Operator Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "owner", "status", "selected_route", "permissions", "data_boundary", "approval_policy", "tests", "fallback", "disable_path", "resolved_at"],
  "properties": {
    "schema_version": {"const": 1},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["configured", "verified", "blocked", "disabled"]},
    "selected_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "version", "immutable_ref", "sha256", "license", "provenance", "reviewed_at"],
      "properties": {
        "kind": {"enum": ["native", "bundled", "skill", "plugin", "mcp", "api", "webhook", "browser", "custom-procedure"]},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "immutable_ref": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "license": {"type": ["string", "null"]},
        "provenance": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "account_identity": {"type": ["string", "null"]},
    "credential_reference": {"type": ["string", "null"]},
    "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "data_boundary": {"type": "string", "minLength": 1},
    "approval_policy": {"type": "string", "minLength": 1},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["synthetic", "approved-real"]},
          "status": {"enum": ["passed", "failed", "blocked"]},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "fallback": {"type": "string", "minLength": 1},
    "disable_path": {"type": "string", "minLength": 1},
    "resolved_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "verified"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "selected_route": {
            "properties": {
              "version": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
              "immutable_ref": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "license": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
              "provenance": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!.*[Uu][Nn][Rr][Ee][Ss][Oo][Ll][Vv][Ee][Dd]).*\\S.*$"
              }
            }
          },
          "tests": {
            "items": {
              "properties": {
                "status": {"const": "passed"},
                "evidence": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
              }
            }
          }
        }
      }
    }
  ]
}
