{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/public-release-audit-report.schema.json",
  "title": "Public release audit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "release", "result", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "release": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "unverified"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "summary"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}, "status": {"enum": ["pass", "fail", "unverified"]}, "summary": {"type": "string", "minLength": 1}}}}
  }
}
