{
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/acceptance-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["policy_version", "policy_digest", "criteria", "consequential", "judgment_heavy", "protected_digests"],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1}, "policy_digest": {"$ref": "#/$defs/digest"},
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "criterion.schema.json"}},
    "consequential": {"type": "boolean"}, "judgment_heavy": {"type": "boolean"},
    "protected_digests": {"type": "object", "additionalProperties": false, "required": ["criteria", "evaluator", "schemas", "protected_tests"], "properties": {"criteria": {"$ref": "#/$defs/digest"}, "evaluator": {"$ref": "#/$defs/digest"}, "schemas": {"$ref": "#/$defs/digest"}, "protected_tests": {"$ref": "#/$defs/digest"}}}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
