{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/enforcement-coverage.schema.json","type":"object","additionalProperties":false,"required":["version","hermes_version","canonical_task_authority","guarantees"],
  "properties":{"version":{"type":"integer","minimum":1},"hermes_version":{"type":"string","minLength":1},"canonical_task_authority":{"const":"native-hermes-kanban"},
    "guarantees":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","owner","enforcement_point","gate","covered_surfaces","known_bypasses","tests","status"],"properties":{
      "id":{"type":"string","pattern":"^[a-z0-9-]+$"},"owner":{"type":"string","minLength":1},"enforcement_point":{"type":"string","minLength":1},"gate":{"type":"string","minLength":1},
      "covered_surfaces":{"type":"array","items":{"type":"string","minLength":1}},"known_bypasses":{"type":"array","items":{"type":"string","minLength":1}},"tests":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^tests/.+\\.py$"}},
      "status":{"enum":["verified","blocked","planned"]}
    }}}
  }
}
