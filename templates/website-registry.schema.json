{
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/website-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Website Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sites"],
  "properties": {
    "schema_version": {"const": 1},
    "sites": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "enabled", "host", "environment", "health_url", "credential_reference", "credential_principal", "owner", "repair_policy", "notification_route", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "enabled": {"type": "boolean"},
          "host": {"type": "string", "pattern": "^(?=.{1,253}$)(?!-)[A-Za-z0-9.-]+(?<!-)$"},
          "environment": {"type": "string", "minLength": 1, "maxLength": 64},
          "health_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "credential_reference": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$", "maxLength": 512},
          "credential_principal": {"type": "string", "minLength": 1, "maxLength": 128},
          "owner": {"type": "string", "minLength": 1, "maxLength": 128},
          "repair_policy": {"type": "string", "minLength": 1, "maxLength": 128},
          "notification_route": {"type": ["string", "null"], "maxLength": 128},
          "status": {"enum": ["configured", "planned", "blocked"]},
          "healthy_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 100, "maximum": 599}},
          "content_contains": {"type": ["string", "null"], "maxLength": 2048},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
          "attempts": {"type": "integer", "minimum": 1, "maximum": 5},
          "retry_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
          "failure_cycles": {"type": "integer", "minimum": 1, "maximum": 10},
          "max_body_bytes": {"type": "integer", "minimum": 256, "maximum": 1048576},
          "allow_private_networks": {"type": "boolean"},
          "allowed_redirect_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
          "allowed_repairs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
          ,"approval_reference": {"type": "string", "pattern": "^approval://", "maxLength": 512}
          ,"approval_version": {"type": "integer", "minimum": 1}
          ,"operator_task_reference": {"type": "string", "pattern": "^kanban://", "maxLength": 512}
          ,"task_version": {"type": "integer", "minimum": 1}
          ,"requirement_version": {"type": "integer", "minimum": 1}
          ,"operation_key": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
