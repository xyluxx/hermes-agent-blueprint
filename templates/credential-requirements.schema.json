{
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/credential-requirements.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential Requirement Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["integration_id", "secret_class", "auth_method", "destination", "owner", "minimum_scopes", "required_for", "status", "verification", "revocation"],
  "properties": {
    "integration_id": {"type": "string", "minLength": 1},
    "secret_class": {"enum": ["model_provider", "oauth", "channel", "mcp", "external_cli", "cloud", "webhook", "encryption", "backup"]},
    "auth_method": {"enum": ["api_key", "oauth", "service_account", "app_password", "certificate", "local_key", "hosted_flow"]},
    "destination": {"type": "string", "minLength": 1},
    "environment_variable": {"type": ["string", "null"]},
    "owner": {"type": "string", "minLength": 1},
    "minimum_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rotation_policy": {"type": ["string", "null"]},
    "required_for": {"type": "string", "minLength": 1},
    "status": {"enum": ["not_required", "missing", "authorization_required", "configured", "authentication_verified", "read_verified", "write_verified", "expired", "revoked", "rotated"]},
    "verification": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "revocation": {"type": "string", "minLength": 1}
  }
}
