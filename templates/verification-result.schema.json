{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/verification-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["criterion_id", "result", "task_id", "task_version", "requirement_version", "artifact_id", "artifact_version", "target_id", "target_version", "environment", "evidence", "verifier", "evaluated_at"],
  "properties": {
    "criterion_id": {"type": "string", "minLength": 1}, "result": {"enum": ["pass", "fail", "blocked", "inconclusive"]},
    "task_id": {"type": "string", "minLength": 1}, "task_version": {"type": "string", "minLength": 1},
    "requirement_version": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1},
    "target_version": {"type": "string", "minLength": 1}, "environment": {"$ref": "#/$defs/environment"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["kind", "verifier_id", "status"], "properties": {"kind": {"enum": ["deterministic", "provider-readback", "reviewer"]}, "verifier_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "blocked", "inconclusive"]}}},
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "criterion_id", "task_id", "task_version", "requirement_version", "artifact_id", "artifact_version", "target_id", "target_version", "environment", "policy_digest", "kind", "source", "reference", "accessible", "relevant", "collector_id", "collected_at", "expires_at", "retention_until", "result", "verifier_kind"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1}, "criterion_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1}, "task_version": {"type": "string", "minLength": 1},
        "requirement_version": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1}, "environment": {"$ref": "#/$defs/environment"},
        "policy_digest": {"$ref": "#/$defs/digest"}, "kind": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "reference": {"type": "string", "format": "uri"}, "accessible": {"const": true}, "relevant": {"const": true}, "content_digest": {"$ref": "#/$defs/digest"},
        "receipt_digest": {"$ref": "#/$defs/digest"}, "collector_id": {"type": "string", "minLength": 1},
        "collected_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "retention_until": {"type": "string", "format": "date-time"}, "result": {"enum": ["pass", "fail", "blocked", "inconclusive"]}, "verifier_kind": {"enum": ["deterministic", "provider-readback", "reviewer"]}
      }, "anyOf": [{"required": ["content_digest"]}, {"required": ["receipt_digest"]}]
    }
  }
}
