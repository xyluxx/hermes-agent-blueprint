{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id": "https://raw.githubusercontent.com/xyluxx/executive-operator-blueprint/main/templates/specialist-contract.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","specialist_id","mode","main_operator","lane","profile","board","client","workspace","credential_scope","schedule_ids","brief","permissions","protected_targets","budget","retirement_condition"],
  "properties":{
    "schema_version":{"const":1},"specialist_id":{"type":"string","minLength":1},"mode":{"const":"managed-team"},"main_operator":{"type":"string","minLength":1},
    "lane":{"type":"string","minLength":1},"profile":{"type":"string","minLength":1},"board":{"type":"string","minLength":1},"client":{"type":"string","minLength":1},"workspace":{"type":"string","minLength":1},
    "credential_scope":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"schedule_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "permissions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"protected_targets":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "retirement_condition":{"type":"string","minLength":1},
    "brief":{"type":"object","additionalProperties":false,"required":["version","requirement_version","included_context","excluded_context","input_versions"],"properties":{
      "version":{"type":"integer","minimum":1},"requirement_version":{"type":"integer","minimum":1},
      "included_context":{"type":"array","minItems":1,"items":{"type":"string","not":{"enum":["all-memory","operator-memory"]}}},
      "excluded_context":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
      "input_versions":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}}
    }},
    "budget":{"type":"object","additionalProperties":false,"required":["total","verification_reserve"],"properties":{"total":{"type":"number","minimum":0},"verification_reserve":{"type":"number","minimum":0}}}
  }
}
